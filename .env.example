# ==============================================================================
# GAZAARABIA MARKETPLACE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# In production, inject these variables via your deployment environment / secrets manager.
# ==============================================================================

# Database connection (MySQL)
DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>"

# Node Environment & Port
NODE_ENV="development"
PORT="3000"

# Application URLs
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
DOMAIN="https://gazaarabia.com"

# Authentication Secrets
JWT_SECRET="<GENERATE_RANDOM_JWT_SECRET_32_BYTES>"
NEXTAUTH_SECRET="<GENERATE_RANDOM_NEXTAUTH_SECRET_32_BYTES>"

# PayPal Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID="<PAYPAL_CLIENT_ID>"
PAYPAL_CLIENT_ID="<PAYPAL_CLIENT_ID>"
PAYPAL_CLIENT_SECRET="<PAYPAL_CLIENT_SECRET>"
PAYPAL_API="https://api-m.sandbox.paypal.com"

# SMTP Email Configuration
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="587"
SMTP_USER="<SMTP_EMAIL_ADDRESS>"
SMTP_PASS="<SMTP_PASSWORD>"
ADMIN_EMAIL="<ADMIN_NOTIFICATION_EMAIL>"

# Guest Cart Key
LOCAL_CART_KEY="gaza_arabia_guest_cart"

# Stripe Payment Gateway
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<STRIPE_PUBLISHABLE_KEY>"
STRIPE_SECRET_KEY="<STRIPE_SECRET_KEY>"
STRIPE_WEBHOOK_SECRET="<STRIPE_WEBHOOK_SECRET>"

# Database Seed Password
SEED_ADMIN_PASSWORD="<INITIAL_ADMIN_SEED_PASSWORD>"

# Shopify Integration (Server-to-Server)
# Local: http://localhost:3001 or Shopify CLI proxy port
# Production: https://shopify.gazaarabia.com
SHOPIFY_APP_URL="https://shopify.gazaarabia.com"

# Shared Internal Secret for Gazaarabia <-> Shopify App server-to-server auth
# MUST match GAZAARABIA_INTERNAL_SECRET in the Shopify app environment
GAZAARABIA_INTERNAL_SECRET="<GENERATE_RANDOM_INTERNAL_SECRET_32_PLUS_CHARS>"

# Cron / Backstop Secret (used for Bearer token auth on /api/cron/*)
CRON_SECRET="<GENERATE_RANDOM_CRON_SECRET>"

# Analytics Tracking (Optional)
NEXT_PUBLIC_GTM_ID="<GOOGLE_TAG_MANAGER_ID>"
NEXT_PUBLIC_GA_MEASUREMENT_ID="<GOOGLE_ANALYTICS_MEASUREMENT_ID>"
NEXT_PUBLIC_FACEBOOK_PIXEL_ID="<FACEBOOK_PIXEL_ID>"
