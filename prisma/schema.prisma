generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users Users[]

  @@map("roles")
}

model Users {
  id               Int             @id @default(autoincrement())
  name             String
  email            String          @unique
  phone            String?
  password         String
  roleId           Int
  isGuest          Boolean         @default(false)
  stripeCustomerId String?         @unique
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime        @default(now())
  googleId         String?         @unique
  addresses        Address[]
  affiliate        Affiliate?
  carts            Cart[]
  createdCoupons   Coupon[]        @relation("CouponCreator")
  notifications    notifications[]
  orders           Orders[]
  returnRequests   ReturnRequest[]
  reviews          Review[]
  seller           seller?
  role             Roles           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  wishlist         Wishlist[]

  @@index([roleId], map: "users_roleId_fkey")
  @@map("users")
}

model seller {
  id                 Int            @id @default(autoincrement())
  userId             Int            @unique
  shopName           String?
  shopSlug           String?        @unique
  logo               String?
  banner             String?
  isActive           Boolean        @default(false)
  status             String         @default("Pending")
  commissionValue    Float          @default(5)
  payoutDays         Int            @default(30)
  minimumPayout      Float          @default(50)
  availableBalance   Float          @default(0)
  pendingBalance     Float          @default(0)
  totalEarned        Float          @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  lastSyncedAt       DateTime?
  shopifyAccessToken String?
  shopifyDomain      String?
  shopifySyncEnabled Boolean        @default(false)
  storeType          String?
  wooConsumerKey     String?
  wooConsumerSecret  String?
  wooSiteUrl         String?
  orderItems         OrderItem[]
  products           products[]
  payouts            SellerPayout[]
  user               Users          @relation(fields: [userId], references: [id])
  storeSyncs         StoreSync[]

  @@index([userId])
  @@index([status])
  @@map("sellers")
}

model StoreSync {
  id        Int      @id @default(autoincrement())
  sellerId  Int
  status    String
  syncType  String
  imported  Int      @default(0)
  skipped   Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  seller    seller   @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([status])
  @@map("store_syncs")
}

model SellerPayout {
  id            Int       @id @default(autoincrement())
  sellerId      Int
  amount        Float
  status        String    @default("pending")
  paymentMethod String?
  paymentRef    String?
  invoiceUrl    String?
  periodLabel   String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  seller        seller    @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([status])
  @@map("seller_payouts")
}

model CategoryCommission {
  id         Int        @id @default(autoincrement())
  categoryId Int        @unique
  commission Float
  isActive   Boolean    @default(true)
  category   Categories @relation(fields: [categoryId], references: [id])

  @@map("category_commissions")
}

model Sizes {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  description    String?          @db.LongText
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  carts          Cart[]
  productvariant productvariant[]

  @@map("sizes")
}

model Colors {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  hexCode        String
  rgbCode        String?
  description    String?          @db.LongText
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  carts          Cart[]
  productvariant productvariant[]

  @@map("colors")
}

model Categories {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  slug               String              @unique
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  description        String?             @db.LongText
  position           Int                 @default(0)
  submenuId          Int?
  submenu            Submenus?           @relation(fields: [submenuId], references: [id], onDelete: Cascade)
  categoryCommission CategoryCommission?
  products           products[]
  subcategories      Subcategory[]

  @@unique([submenuId, position])
  @@map("categories")
}

model Subcategory {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique
  slug                  String                 @unique
  categoryId            Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  description           String?                @db.LongText
  position              Int                    @default(0)
  products              products[]
  category              Categories             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategorycommission subcategorycommission?

  @@unique([categoryId, position])
  @@index([categoryId], map: "subcategories_categoryId_fkey")
  @@map("subcategories")
}

model MaterialCare {
  id          Int        @id @default(autoincrement())
  title       String
  description String     @db.LongText
  careType    String?
  material    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  icon        String?
  products    products[]

  @@map("material_care")
}

model DeliveryOptions {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.LongText
  minTime     Int
  maxTime     Int
  cutOffTime  String
  cost        Float
  freeOver    Float?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("delivery_options")
}

model BlogCategories {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blogs[]
  menus     Menus[]  @relation("BlogCategoryMenus")

  @@map("blog_categories")
}

model Blogs {
  id         Int            @id @default(autoincrement())
  title      String
  slug       String         @unique(map: "Blogs_slug_key")
  content    String         @db.LongText
  categoryId Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  image      String?
  category   BlogCategories @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "blogs_categoryId_fkey")
  @@map("blogs")
}

model brand {
  id         Int        @id @default(autoincrement())
  name       String     @unique(map: "Brand_name_key")
  logo       String?
  isTrending Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  products   products[]
}

model productimage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  colorId   Int?
  primary   Boolean  @default(false)
  productId Int
  products  products @relation(fields: [productId], references: [id], map: "ProductImage_productId_fkey")

  @@index([productId], map: "ProductImage_productId_fkey")
}

model products {
  id                    Int               @id @default(autoincrement())
  sellerId              Int
  slug                  String            @unique
  description           String?           @db.LongText
  active                Boolean           @default(true)
  barcode               String?
  baseQty               Int
  brandId               Int?
  categoryId            Int?
  costPrice             Float?
  discountPrice         Float?
  fitType               String?
  sellingPrice          Float
  commissionValue       Float             @default(5)
  shortDescription      String?           @db.LongText
  subcategoryId         Int?
  title                 String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  materialCareId        Int?
  soldHighlightDuration Int?
  soldCount             Int?
  ambassadorId          Int?
  externalProductId     String?
  externalSource        String?
  externalVariantId     String?
  isExternalProduct     Boolean           @default(false)
  carts                 Cart[]
  orderItems            OrderItem[]
  asChildRelations      ProductRelation[] @relation("ProductAsChild")
  asParentRelations     ProductRelation[] @relation("ProductAsParent")
  productimage          productimage[]
  brand                 brand?            @relation(fields: [brandId], references: [id], map: "Products_brandId_fkey")
  categories            Categories?       @relation(fields: [categoryId], references: [id], map: "Products_categoryId_fkey")
  subcategories         Subcategory?      @relation(fields: [subcategoryId], references: [id], map: "Products_subcategoryId_fkey")
  ambassador            Affiliate?        @relation("AffiliateAmbassadorRelation", fields: [ambassadorId], references: [id])
  materialCare          MaterialCare?     @relation(fields: [materialCareId], references: [id])
  seller                seller            @relation(fields: [sellerId], references: [id])
  productvariant        productvariant[]
  reviews               Review[]
  variantImages         VariantImage[]
  wishlist              Wishlist[]

  @@index([sellerId])
  @@index([brandId], map: "Products_brandId_fkey")
  @@index([categoryId], map: "Products_categoryId_fkey")
  @@index([subcategoryId], map: "Products_subcategoryId_fkey")
  @@index([ambassadorId], map: "products_ambassadorId_fkey")
  @@index([materialCareId], map: "products_materialCareId_fkey")
}

model productvariant {
  id             Int            @id @default(autoincrement())
  sku            String
  price          Float
  stock          Int
  isActive       Boolean        @default(true)
  colorId        Int?
  sizeId         Int?
  productId      Int
  videoUrl       String?
  videoThumbnail String?
  carts          Cart[]
  orderItems     OrderItem[]
  products       products       @relation(fields: [productId], references: [id], map: "ProductVariant_productId_fkey")
  color          Colors?        @relation(fields: [colorId], references: [id])
  size           Sizes?         @relation(fields: [sizeId], references: [id])
  reviews        Review[]
  variantImages  VariantImage[]

  @@index([productId], map: "ProductVariant_productId_fkey")
  @@index([colorId], map: "productvariant_colorId_fkey")
  @@index([sizeId], map: "productvariant_sizeId_fkey")
}

model VariantImage {
  id        Int            @id @default(autoincrement())
  url       String
  alt       String?
  variantId Int
  productId Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  product   products?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   productvariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId], map: "variant_images_productId_fkey")
  @@index([variantId], map: "variant_images_variantId_fkey")
  @@map("variant_images")
}

model Address {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String?
  company    String?
  address1   String   @db.LongText
  address2   String?  @db.LongText
  city       String
  country    String
  postalCode String
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     Int
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "addresses_userId_fkey")
  @@map("addresses")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  product   products @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId], map: "wishlist_productId_fkey")
  @@map("wishlist")
}

model Cart {
  id        Int            @id @default(autoincrement())
  userId    Int
  productId Int
  colorId   Int?
  sizeId    Int?
  variantId Int
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  color     Colors?        @relation(fields: [colorId], references: [id])
  product   products       @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Sizes?         @relation(fields: [sizeId], references: [id])
  user      Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   productvariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
  @@index([colorId], map: "carts_colorId_fkey")
  @@index([productId], map: "carts_productId_fkey")
  @@index([sizeId], map: "carts_sizeId_fkey")
  @@index([variantId], map: "carts_variantId_fkey")
  @@map("carts")
}

model Orders {
  id                  Int               @id @default(autoincrement())
  userId              Int
  itemsTotal          Float
  subtotal            Float
  shippingCost        Float             @default(0)
  discountTotal       Float             @default(0)
  taxTotal            Float             @default(0)
  totalAmount         Float
  currency            String            @default("GBP")
  paymentMethod       String
  transactionId       String?
  status              String            @default("pending")
  paymentResponse     String?           @db.LongText
  addressId           Int?
  firstName           String
  lastName            String?
  company             String?
  address1            String
  address2            String?
  city                String
  country             String
  postalCode          String
  phone               String
  deliveryOptionId    Int?
  deliveryName        String?
  deliveryEta         String?
  notes               String?
  couponCode          String?
  couponDiscount      Float?            @default(0)
  couponId            Int?
  affiliateId         Int?
  affiliateCommission Float?
  affiliateEarning    Float?
  affiliatePaid       Boolean           @default(false)
  invoiceNumber       String?
  invoiceUrl          String?
  charityDonationId   Int?
  charityAmount       Float?            @default(0)
  ambassadorId        Int?
  ambassadorPaid      Boolean           @default(false)
  referralDiscount    Float?            @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  charityDonation     CharityDonations?
  affiliate           Affiliate?        @relation("OrderAffiliateRelation", fields: [affiliateId], references: [id])
  ambassador          Affiliate?        @relation("OrderAmbassadorRelation", fields: [ambassadorId], references: [id])
  coupon              Coupon?           @relation(fields: [couponId], references: [id])
  user                Users             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems          OrderItem[]
  returnRequests      ReturnRequest[]

  @@index([userId])
  @@index([affiliateId], map: "orders_affiliateId_fkey")
  @@index([ambassadorId], map: "orders_ambassadorId_fkey")
  @@index([couponId], map: "orders_couponId_fkey")
  @@map("orders")
}

model OrderItem {
  id                           Int             @id @default(autoincrement())
  sellerId                     Int
  orderId                      Int
  productId                    Int
  variantId                    Int
  colorId                      Int?
  sizeId                       Int?
  quantity                     Int
  price                        Float
  subtotal                     Float
  sku                          String?
  title                        String?
  reviewed                     Boolean         @default(false)
  commissionType               String          @default("percentage")
  commissionValue              Float
  commissionAmount             Float
  sellerEarning                Float
  payoutDays                   Int
  payoutEligibleAt             DateTime
  isPayoutEligible             Boolean         @default(false)
  isPaidOut                    Boolean         @default(false)
  ambassadorId                 Int?
  ambassadorCommission         Float?
  ambassadorEarning            Float?
  ambassadorPaid               Boolean         @default(false)
  returnStatus                 String?
  refundedAmount               Float?
  affiliateEarning             Float?
  affiliateCommissionAdjusted  Boolean         @default(false)
  ambassadorCommissionAdjusted Boolean         @default(false)
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  externalOrderId              String?
  ambassador                   Affiliate?      @relation("OrderItemAmbassadorRelation", fields: [ambassadorId], references: [id])
  order                        Orders          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                      products        @relation(fields: [productId], references: [id])
  seller                       seller          @relation(fields: [sellerId], references: [id])
  variant                      productvariant  @relation(fields: [variantId], references: [id])
  returnRequests               ReturnRequest[]
  reviews                      Review[]

  @@index([ambassadorId], map: "orders_item_ambassadorId_fkey")
  @@index([orderId], map: "orders_item_orderId_fkey")
  @@index([productId], map: "orders_item_productId_fkey")
  @@index([sellerId], map: "orders_item_sellerId_fkey")
  @@index([variantId], map: "orders_item_variantId_fkey")
  @@map("orders_item")
}

model Review {
  id          Int             @id @default(autoincrement())
  rating      Int
  comment     String          @db.LongText
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  productId   Int
  variantId   Int?
  userId      Int
  orderItemId Int?
  image       String?
  isPinned    Boolean         @default(false)
  video       String?
  orderItem   OrderItem?      @relation(fields: [orderItemId], references: [id])
  product     products        @relation(fields: [productId], references: [id])
  user        Users           @relation(fields: [userId], references: [id])
  variant     productvariant? @relation(fields: [variantId], references: [id])

  @@index([orderItemId], map: "review_orderItemId_fkey")
  @@index([productId], map: "review_productId_fkey")
  @@index([userId], map: "review_userId_fkey")
  @@index([variantId], map: "review_variantId_fkey")
  @@map("review")
}

model Menus {
  id             Int             @id @default(autoincrement())
  name           String
  slug           String          @unique
  type           String
  images         String?         @db.LongText
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  blogCategoryId Int?
  blogCategory   BlogCategories? @relation("BlogCategoryMenus", fields: [blogCategoryId], references: [id])
  submenus       Submenus[]

  @@index([blogCategoryId], map: "menus_blogCategoryId_fkey")
  @@map("menus")
}

model Submenus {
  id         Int          @id @default(autoincrement())
  name       String
  slug       String       @unique
  menuId     Int
  position   Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  categories Categories[]
  menu       Menus        @relation(fields: [menuId], references: [id], onDelete: Cascade, map: "submenus_menuId_fkey")

  @@unique([menuId, position])
  @@map("submenus")
}

model ProductRelation {
  id           Int      @id @default(autoincrement())
  parentId     Int
  childId      Int
  relationType String   @default("wear_with")
  sortOrder    Int?
  createdAt    DateTime @default(now())
  child        products @relation("ProductAsChild", fields: [childId], references: [id], onDelete: Cascade)
  parent       products @relation("ProductAsParent", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId, relationType])
  @@index([childId], map: "product_relations_childId_fkey")
  @@map("product_relations")
}

model notifications {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String?
  subject   String   @db.LongText
  message   String   @db.LongText
  type      String
  status    String
  createdAt DateTime @default(now())
  user      Users?   @relation(fields: [userId], references: [id])

  @@index([userId], map: "notifications_userId_fkey")
}

model FaqCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  faqs      Faq[]

  @@map("faq_categories")
}

model Faq {
  id         Int         @id @default(autoincrement())
  question   String
  answer     String      @db.LongText
  categoryId Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId], map: "faqs_categoryId_fkey")
  @@map("faqs")
}

model ContactUs {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String   @db.LongText
  message   String   @db.LongText
  createdAt DateTime @default(now())

  @@map("contact_us")
}

model Affiliate {
  id                   Int                   @id @default(autoincrement())
  userId               Int                   @unique(map: "Affiliate_userId_unique")
  baseCommission       Float                 @default(10)
  shareCommission      Float                 @default(7)
  referralCode         String                @unique
  type                 String                @default("affiliate")
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 Users                 @relation(fields: [userId], references: [id])
  bankAccount          AffiliateBankAccount?
  invoices             AffiliateInvoice[]
  ambassadorInvoices   AmbassadorInvoice[]
  coupons              Coupon[]
  orders               Orders[]              @relation("OrderAffiliateRelation")
  ambassadorOrders     Orders[]              @relation("OrderAmbassadorRelation")
  orderItemAmbassadors OrderItem[]           @relation("OrderItemAmbassadorRelation")
  payout               payout[]
  products             products[]            @relation("AffiliateAmbassadorRelation")

  @@map("affiliate")
}

model Coupon {
  id             Int        @id @default(autoincrement())
  code           String     @unique
  discountType   String     @default("percentage")
  discountValue  Float
  affiliateId    Int?
  creatorId      Int?
  usageCount     Int        @default(0)
  maxUsage       Int?
  perUserLimit   Int?       @default(1)
  minOrderAmount Float?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  affiliate      Affiliate? @relation(fields: [affiliateId], references: [id])
  creator        Users?     @relation("CouponCreator", fields: [creatorId], references: [id])
  orders         Orders[]

  @@index([affiliateId], map: "coupon_affiliateId_fkey")
  @@index([creatorId], map: "coupon_creatorId_fkey")
  @@map("coupon")
}

model AffiliateInvoice {
  id              Int       @id @default(autoincrement())
  affiliateId     Int
  invoiceNumber   String
  invoiceUrl      String
  monthLabel      String
  totalAmount     Float
  isPaid          Boolean   @default(false)
  paymentMethod   String?
  paymentRef      String?
  paidAt          DateTime?
  deductionAmount Float?    @default(0)
  createdAt       DateTime  @default(now())
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId], map: "affiliate_invoice_affiliateId_fkey")
  @@map("affiliate_invoice")
}

model HomePageSetting {
  id                   Int      @id @default(autoincrement())
  heroSlides           String?  @db.LongText
  shopByCategory       String?  @db.LongText
  midBanner            String?
  signatureProducts    String?  @db.LongText
  headerText           String?  @db.LongText
  affiliateCommission  Int?
  ambassadorCommission Int?
  updatedAt            DateTime @updatedAt

  @@map("homepage_settings")
}

model ReturnReason {
  id             Int             @id @default(autoincrement())
  label          String          @unique
  requireImage   Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  returnRequests ReturnRequest[]

  @@map("return_reasons")
}

model ReturnRequest {
  id                   Int          @id @default(autoincrement())
  userId               Int
  orderId              Int
  orderItemId          Int
  reasonId             Int
  note                 String?      @db.LongText
  images               String?      @db.LongText
  status               String       @default("pending")
  adminNote            String?      @db.LongText
  refundAmount         Float?
  expectedReturnAmount Float?       @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  order                Orders       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem            OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  reason               ReturnReason @relation(fields: [reasonId], references: [id], onDelete: Cascade)
  user                 Users        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "return_requests_orderId_fkey")
  @@index([orderItemId], map: "return_requests_orderItemId_fkey")
  @@index([reasonId], map: "return_requests_reasonId_fkey")
  @@index([userId], map: "return_requests_userId_fkey")
  @@map("return_requests")
}

model SolidarityReceipts {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?  @db.LongText
  amount       Float
  receiptImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("solidarity_receipts")
}

model CharityDonations {
  id            Int      @id @default(autoincrement())
  name          String?
  email         String
  amount        Float
  anonymous     Boolean  @default(false)
  message       String?  @db.LongText
  transactionId String?
  paymentMethod String?
  paymentStatus String   @default("pending")
  receiptUrl    String?
  orderId       Int?     @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Orders?  @relation(fields: [orderId], references: [id])

  @@map("charity_donations")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscribers")
}

model AmbassadorInvoice {
  id              Int       @id @default(autoincrement())
  ambassadorId    Int
  invoiceNumber   String
  invoiceUrl      String
  monthLabel      String
  totalAmount     Float
  isPaid          Boolean   @default(false)
  paymentMethod   String?
  paymentRef      String?
  paidAt          DateTime?
  deductionAmount Float?    @default(0)
  createdAt       DateTime  @default(now())
  ambassador      Affiliate @relation(fields: [ambassadorId], references: [id])

  @@index([ambassadorId], map: "ambassador_invoice_ambassadorId_fkey")
  @@map("ambassador_invoice")
}

model DeliverySettings {
  id                            Int      @id @default(1)
  freeDeliveryText              String?  @db.LongText
  nextDayTitle                  String?  @db.LongText
  nextDayDeliveryTime           String?
  nextDayCost                   String?
  nextDayOrderCutOff            String?
  standardDeliveryTitle         String?  @db.LongText
  standardDeliveryMinDays       Int?
  standardDeliveryMaxDays       Int?
  standardDeliveryCost          String?
  returnText                    String?  @db.LongText
  internationalTitle            String?  @db.LongText
  internationalDeliveryTime     String?
  internationalCost             String?
  internationalFreeDeliveryText String?  @db.LongText
  internationalCustomsText      String?  @db.LongText
  internationalTrackingText     String?  @db.LongText
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@map("delivery_settings")
}

model AffiliateBankAccount {
  id            Int       @id @default(autoincrement())
  affiliateId   Int       @unique
  accountName   String
  accountNumber String
  sortCode      String?
  iban          String?
  paypalEmail   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("affiliate_bank_accounts")
}

model payout {
  id            Int       @id @default(autoincrement())
  affiliateId   Int
  amount        Float
  status        String    @default("pending")
  paymentMethod String?
  paymentRef    String?
  invoiceUrl    String?
  periodLabel   String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], map: "Payout_affiliateId_fkey")

  @@index([affiliateId], map: "Payout_affiliateId_fkey")
}

model platformsettings {
  id                     Int      @id @default(autoincrement())
  defaultCommissionValue Float    @default(5)
  createdAt              DateTime @default(now())
  updatedAt              DateTime
}

model subcategorycommission {
  id            Int         @id @default(autoincrement())
  subcategoryId Int         @unique(map: "SubcategoryCommission_subcategoryId_key")
  commission    Float
  isActive      Boolean     @default(true)
  subcategories Subcategory @relation(fields: [subcategoryId], references: [id], map: "SubcategoryCommission_subcategoryId_fkey")
}
