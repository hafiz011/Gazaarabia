generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users Users[]

  @@map("roles")
}

model Users {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  phone          String?
  password       String
  roleId         Int
  isGuest        Boolean  @default(false)

  stripeCustomerId  String?   @unique

  resetToken        String?
  resetTokenExpiry  DateTime?

  createdAt      DateTime @default(now())
  googleId       String?  @unique
  role           Roles    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdCoupons Coupon[] @relation("CouponCreator")

  affiliate Affiliate?

  addresses     Address[]
  wishlist      Wishlist[]
  carts         Cart[]
  orders        Orders[]
  reviews       Review[]
  notifications notifications[]
  returnRequests ReturnRequest[]
  seller         seller? //  opposite relation
  refreshTokens  RefreshToken[]


  @@index([roleId], map: "users_roleId_fkey")
  @@map("users")
}

model seller {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique
  shopName String?
  shopSlug String?  @unique
  logo     String?
  banner   String?
  isActive Boolean @default(false)
  status   String  @default("Pending")

  // Commission Config
  commissionValue Float  @default(5)

  // Payout Config
  payoutDays    Int   @default(30)
  minimumPayout Float @default(50)

  // Balances
  availableBalance Float @default(0)
  pendingBalance   Float @default(0)
  totalEarned      Float @default(0)

  // Store Integration
  storeType          String?   // "shopify" | "woocommerce" | null
  shopifyDomain      String?
  shopifyAccessToken String?
  wooSiteUrl         String?
  wooConsumerKey     String?
  wooConsumerSecret  String?
  shopifySyncEnabled Boolean   @default(false)
  lastSyncedAt       DateTime?


  products   products[]
  payouts    SellerPayout[]
  orderItems OrderItem[]
  storeSyncs StoreSync[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([shopifyDomain]) // resolveSellerByShop filters on this per webhook/link call
  @@map("sellers")
}

model StoreSync {
  id         Int      @id @default(autoincrement())
  sellerId   Int
  seller     seller   @relation(fields: [sellerId], references: [id])
  status     String   // "success" | "failed" | "running"
  syncType   String   // "manual" | "auto"
  imported   Int      @default(0)
  skipped    Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())

  @@index([sellerId])
  @@index([status])
  @@map("store_syncs")
}

model SellerPayout {
  id            Int     @id @default(autoincrement())
  sellerId      Int
  amount        Float
  status        String  @default("pending") // pending | paid
  paymentMethod String?
  paymentRef    String?
  invoiceUrl    String?
  periodLabel   String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  seller seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([status])
  @@map("seller_payouts")
}

model PlatformSettings {
  id                     Int      @id @default(autoincrement())
  defaultCommissionValue Float    @default(5)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("platform_settings")
}

model CategoryCommission {
  id             Int     @id @default(autoincrement())
  categoryId     Int     @unique
  commission     Float
  isActive       Boolean @default(true)

  category      Categories   @relation(fields: [categoryId], references: [id])

  @@map("category_commissions")
}
model SubcategoryCommission {
  id            Int   @id @default(autoincrement())
  subcategoryId Int   @unique
  commission    Float 
  isActive      Boolean @default(true)

  subcategory Subcategory @relation(fields: [subcategoryId], references: [id])
}

model Sizes {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?   @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productvariant productvariant[]
  carts          Cart[]

  @@map("sizes")
}

model Colors {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  hexCode        String
  rgbCode        String?
  description    String?          @db.LongText
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  productvariant productvariant[]
  carts          Cart[]

  @@map("colors")
}

model Categories {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  slug          String        @unique
  submenuId     Int?
  image         String?  
  description   String?       @db.LongText
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  position      Int      @default(0)
  products      products[]
  subcategories Subcategory[]
  categoryCommission CategoryCommission?
  submenu   Submenus? @relation(fields: [submenuId], references: [id], onDelete: Cascade)
  @@unique([submenuId, position])
  @@map("categories")
}

model Subcategory {
  id            Int        @id @default(autoincrement())
  name          String     @unique
  slug          String     @unique
  categoryId    Int
  description   String?    @db.LongText
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  position      Int        @default(0)
  products      products[]
  subcategoryCommission SubcategoryCommission?
  category   Categories @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId], map: "subcategories_categoryId_fkey")
  @@unique([categoryId, position])
  @@map("subcategories")
}

model MaterialCare {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.LongText
  careType    String?
  material    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  icon        String?

  products products[]

  @@map("material_care")
}

model DeliveryOptions {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.LongText
  minTime     Int
  maxTime     Int
  cutOffTime  String
  cost        Float
  freeOver    Float?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("delivery_options")
}

model BlogCategories {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blogs[]

  menus Menus[] @relation("BlogCategoryMenus")

  @@map("blog_categories")
}

model Blogs {
  id         Int            @id @default(autoincrement())
  title      String
  slug       String         @unique(map: "Blogs_slug_key")
  content    String         @db.LongText
  categoryId Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  image      String?
  category   BlogCategories @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "blogs_categoryId_fkey")
  @@map("blogs")
}

model brand {
  id         Int        @id @default(autoincrement())
  name       String     @unique(map: "Brand_name_key")
  logo       String?
  isTrending Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  products   products[]
}


model productimage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  colorId   Int?
  primary   Boolean  @default(false)
  productId Int
  products  products @relation(fields: [productId], references: [id], map: "ProductImage_productId_fkey")

  @@index([productId], map: "ProductImage_productId_fkey")
}

model products {
  id               Int              @id @default(autoincrement())
  sellerId         Int
  slug             String           @unique
  description      String?          @db.LongText
  active           Boolean          @default(true)
  isDeleted        Boolean          @default(false)
  barcode          String?
  baseQty          Int
  brandId          Int?
  categoryId       Int?
  costPrice        Float?
  discountPrice    Float?
  fitType          String?
  sellingPrice     Float
  commissionValue  Float   @default(5)
  shortDescription String?           @db.LongText
  subcategoryId    Int?
  title            String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  productimage     productimage[]
  brand            brand?           @relation(fields: [brandId], references: [id], map: "Products_brandId_fkey")
  categories       Categories?      @relation(fields: [categoryId], references: [id], map: "Products_categoryId_fkey")
  subcategories    Subcategory?     @relation(fields: [subcategoryId], references: [id], map: "Products_subcategoryId_fkey")
  seller         seller           @relation(fields: [sellerId], references: [id])
  productvariant   productvariant[]

  materialCareId Int?
  materialCare   MaterialCare? @relation(fields: [materialCareId], references: [id])

  wishlist      Wishlist[]
  carts         Cart[]
  orderItems    OrderItem[]
  reviews       Review[]
  variantImages VariantImage[]

  soldHighlightDuration Int?     // duration in hours
  soldCount             Int?     // number sold in this duration

  ambassadorId          Int?     // assigned ambassador
  ambassador            Affiliate? @relation("AffiliateAmbassadorRelation", fields: [ambassadorId], references: [id])

  // External Store Tracking
  externalProductId  String?   // unique per seller (see @@unique below), NOT globally
  externalVariantId  String?
  externalSource     String?   // "shopify" | "woocommerce"
  isExternalProduct  Boolean   @default(false)



  // NEW — Back-relations for ProductRelation
  asParentRelations ProductRelation[] @relation("ProductAsParent")
  asChildRelations  ProductRelation[] @relation("ProductAsChild")

  @@index([sellerId])
  @@index([brandId], map: "Products_brandId_fkey")
  @@index([categoryId], map: "Products_categoryId_fkey")
  @@index([subcategoryId], map: "Products_subcategoryId_fkey")
  @@index([active, isDeleted, createdAt(sort: Desc)])
  @@index([slug])
  @@index([isExternalProduct])
  // A given external product id is unique within one seller's store, but two
  // different sellers' stores can legitimately reuse the same id (WooCommerce
  // ids start at 1 per site), so scope uniqueness to the seller.
  @@unique([sellerId, externalProductId])
}

model productvariant {
  id        Int     @id @default(autoincrement())
  sku       String
  price     Float
  stock     Int
  isActive  Boolean @default(true)
  colorId   Int?
  sizeId    Int?
  productId Int

  videoUrl       String?
  videoThumbnail String?

  // ── Shopify external identity + metadata (Milestone 2.6) ──
  externalVariantId String?   // gid://shopify/ProductVariant/… (primary external id)
  externalProductId String?   // gid://shopify/Product/…
  inventoryItemId   String?   // gid://shopify/InventoryItem/…
  externalSource    String?   // "shopify"
  barcode           String?
  compareAtPrice    Float?
  weight            Float?
  weightUnit        String?
  taxable           Boolean?
  requiresShipping  Boolean?
  position          Int?
  options           Json?     // [{ name, value }] — arbitrary Shopify options
  imageUrl          String?   // variant image (falls back to product image)
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?


  products products @relation(fields: [productId], references: [id], map: "ProductVariant_productId_fkey")
  color    Colors?  @relation(fields: [colorId], references: [id])
  size     Sizes?   @relation(fields: [sizeId], references: [id])

  variantImages VariantImage[]
  carts         Cart[]
  orderItems    OrderItem[] // This is required to complete the relation
  reviews       Review[]

  @@unique([productId, externalVariantId], map: "productvariant_product_externalVariant_key")
  @@index([productId], map: "ProductVariant_productId_fkey")
  @@index([colorId], map: "productvariant_colorId_fkey")
  @@index([externalVariantId], map: "productvariant_externalVariantId_idx")
}

model VariantImage {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String?
  variantId Int
  productId Int?

  variant productvariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product products?      @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("variant_images")
}

model Address {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String?
  company    String?
  address1   String  @db.LongText
  address2   String?  @db.LongText
  city       String
  country    String
  postalCode String
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  //  Relation to Users
  userId Int
  user   Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  // Relations
  user    Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // Prevent duplicate wishlist entries
  @@map("wishlist")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  colorId   Int?
  sizeId    Int?
  variantId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product products       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Colors?        @relation(fields: [colorId], references: [id])
  size    Sizes?         @relation(fields: [sizeId], references: [id])
  variant productvariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId]) // Prevent duplicate variant entries in the cart
  @@map("carts")
}

model Orders {
  id     Int @id @default(autoincrement())
  userId Int

  //  Amount Details
  itemsTotal    Float
  subtotal      Float
  shippingCost  Float  @default(0)
  discountTotal Float  @default(0)
  taxTotal      Float  @default(0)
  totalAmount   Float
  currency      String @default("GBP")

  //  Payment Info
  paymentMethod  String
  transactionId  String?
  status         String  @default("pending")
  paymentResponse Json?

  //  Shipping Address Snapshot
  addressId  Int?
  firstName  String
  lastName   String?
  company    String?
  address1   String
  address2   String?
  city       String
  country    String
  postalCode String
  phone      String

  //  Delivery Options
  deliveryOptionId Int?
  deliveryName     String?
  deliveryEta      String?

  //  Meta
  notes          String?
  couponCode     String?
  couponDiscount Float?  @default(0)

  // Coupon relation (NEW)
  couponId Int?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  // Direct affiliate relation (NEW)
  affiliateId         Int?
  affiliateCommission Float? // <-- store % used at order time
  affiliateEarning    Float? // <-- store calculated earning (money)
  // Affiliate relation (coupon-based)
  affiliate           Affiliate? @relation("OrderAffiliateRelation", fields: [affiliateId], references: [id])

  affiliatePaid Boolean @default(false)

  invoiceNumber String?   // stores invoice code like INV-000001
  invoiceUrl    String?   // link to PDF stored locally or S3

  charityDonationId Int?
  charityAmount Float? @default(0)
  charityDonation CharityDonations?

  ambassadorId   Int?
  ambassadorPaid Boolean @default(false)

  referralDiscount Float? @default(0)

  // Ambassador relation (product-based)
  ambassador          Affiliate? @relation("OrderAmbassadorRelation", fields: [ambassadorId], references: [id])


  //  Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //  Relations
  // Restrict (not Cascade): a user with orders must not be hard-deleted — it would
  // destroy sales/financial history. Soft-delete the user instead.
  user       Users       @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  returnRequests ReturnRequest[]


  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([transactionId]) // Stripe webhook looks up orders by payment intent id
  @@index([couponCode])    // coupon per-user-limit check filters on this
  @@map("orders")
}

model OrderItem {
  id        Int  @id @default(autoincrement())
  sellerId  Int
  orderId   Int
  productId Int
  variantId Int // main source of truth (points to productvariant)
  colorId   Int?
  sizeId    Int?

  quantity Int
  price    Float
  subtotal Float
  sku      String?
  title    String?
  reviewed Boolean @default(false)

 // Commission Snapshot
  commissionType   String @default("percentage")
  commissionValue  Float
  commissionAmount Float
  sellerEarning    Float

  payoutDays       Int
  payoutEligibleAt DateTime
  isPayoutEligible Boolean  @default(false)
  isPaidOut        Boolean  @default(false)

  //  Ambassador earning tracking per product
  ambassadorId         Int?
  ambassadorCommission Float?
  ambassadorEarning    Float?
  ambassadorPaid       Boolean @default(false)   //  NEW: paid/unpaid status

  returnStatus         String?
  refundedAmount       Float?
 
  // External Order Tracking
  externalOrderId   String?
  fulfillmentStatus String?   // item-level status from external store webhook (e.g. shipped/cancelled/confirmed)

  // Shopify order mapping/status (Milestone 3)
  externalOrderName       String?   // Shopify order name e.g. "#1001"
  externalFinancialStatus String?   // paid | refunded | partially_refunded | pending
  trackingNumber          String?
  trackingCompany         String?
  trackingUrl             String?   @db.LongText
  externalSyncedAt        DateTime?

  // Affiliate commission per item
  affiliateEarning       Float?
  affiliateCommissionAdjusted Boolean @default(false)

  // Ambassador commission per item
  ambassadorCommissionAdjusted Boolean @default(false)


  ambassador Affiliate? @relation("OrderItemAmbassadorRelation", fields: [ambassadorId], references: [id])


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Orders         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product products       @relation(fields: [productId], references: [id])
  variant productvariant @relation(fields: [variantId], references: [id]) //  matches productvariant.orderItems
  seller  seller         @relation(fields: [sellerId], references: [id])

  reviews Review[]
  returnRequests ReturnRequest[]


  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([sellerId])
  @@index([payoutEligibleAt])
  @@index([externalOrderId]) // Shopify/Woo order-status webhooks match on this
  @@map("orders_item")
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String   @db.LongText
  image     String?
  video     String?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Product Reference
  productId Int
  product   products @relation(fields: [productId], references: [id])

  // Variant Reference 
  variantId Int?
  variant   productvariant? @relation(fields: [variantId], references: [id])

  // User Reference
  userId Int
  user   Users @relation(fields: [userId], references: [id])

  // Optional: Link back to order item
  orderItemId Int?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([userId])
  @@index([rating])
  @@map("review")
}

model Menus {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  type      String
  images    Json?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submenus     Submenus[]
  blogCategoryId Int?
  blogCategory BlogCategories? @relation("BlogCategoryMenus", fields: [blogCategoryId], references: [id])

  @@map("menus")
}


model Submenus {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  menuId             Int
  position           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  menu               Menus        @relation(fields: [menuId], references: [id], onDelete: Cascade, map: "submenus_menuId_fkey")
  categories         Categories[]
  
  @@unique([menuId, position])
  @@map("submenus")
}

model ProductRelation {
  id           Int      @id @default(autoincrement())
  parentId     Int
  childId      Int
  relationType String   @default("wear_with")
  sortOrder    Int?
  createdAt    DateTime @default(now())

  // Properly linked relations with unique names
  parent products @relation("ProductAsParent", fields: [parentId], references: [id], onDelete: Cascade)
  child  products @relation("ProductAsChild", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId, relationType])
  @@map("product_relations")
}

model notifications {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String?
  subject   String  @db.LongText
  message   String  @db.LongText
  type      String // e.g. "email", "sms", etc.
  status    String // "sent", "failed"
  createdAt DateTime @default(now())

  user Users? @relation(fields: [userId], references: [id])
}

model FaqCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faqs Faq[] // One-to-many relation

  @@map("faq_categories")
}

model Faq {
  id         Int      @id @default(autoincrement())
  question   String
  answer     String   @db.LongText
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("faqs")
}

model ContactUs {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String   @db.LongText
  message   String   @db.LongText
  createdAt DateTime @default(now())

  @@map("contact_us")
}

model Affiliate {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique(map: "Affiliate_userId_unique")
  user            Users    @relation(fields: [userId], references: [id])
  baseCommission  Float    @default(10) // Admin's commission percentage
  shareCommission Float    @default(7) // Affiliate's shared portion (% discount)
  referralCode   String  @unique  
  type        String   @default("affiliate") // "affiliate" or "ambassador"


  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Back-relations
  payouts Payout[]
  coupons Coupon[] // coupons owned by this affiliate

  invoices AffiliateInvoice[]
  ambassadorInvoices AmbassadorInvoice[]


  // Order-level commissions
  orders            Orders[] @relation("OrderAffiliateRelation")
  ambassadorOrders  Orders[] @relation("OrderAmbassadorRelation")

  // Item-level ambassador commissions
  orderItemAmbassadors OrderItem[] @relation("OrderItemAmbassadorRelation")

  // Product-level ambassador mapping
  products products[] @relation("AffiliateAmbassadorRelation")

  bankAccount AffiliateBankAccount?

 @@map("affiliate")
}

model Payout {
  id            Int       @id @default(autoincrement())
  affiliateId   Int
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id])
  amount        Float
  status        String    @default("pending") // pending | paid
  paymentMethod String?
  paymentRef    String?
  invoiceUrl    String? 
  periodLabel   String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
}

// Audit trail for sensitive admin mutations (e.g. affiliate edit/delete)
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int      // admin user id who performed the action
  action    String   // e.g. "PUT" | "DELETE"
  entity    String   // e.g. "Affiliate"
  entityId  Int      // id of the affected record
  createdAt DateTime @default(now())

  @@map("audit_log")
}

model Coupon {
  id            Int    @id @default(autoincrement())
  code          String @unique
  discountType  String @default("percentage") // "percentage" | "fixed"
  discountValue Float

  // Relations
  affiliateId Int?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  creatorId Int? // who created this coupon (admin or affiliate)
  creator   Users? @relation("CouponCreator", fields: [creatorId], references: [id])

  // Usage and limits
  usageCount     Int       @default(0)
  maxUsage       Int?
  perUserLimit   Int?      @default(1)
  minOrderAmount Float?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)

  //  Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //  Optional relation to Orders (if you track coupon usage per order)
  orders Orders[]

  @@map("coupon")
}


model AffiliateInvoice {
