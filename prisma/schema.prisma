generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users Users[]

  @@map("roles")
}

model Users {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  roleId    Int
  createdAt DateTime @default(now())
  role      Roles    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  addresses Address[]

  @@index([roleId], map: "users_roleId_fkey")
  @@map("users")
}

model Sizes {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?

  @@map("sizes")
}

model Colors {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  hexCode        String
  rgbCode        String?
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  productvariant productvariant[]

  @@map("colors")
}

model Categories {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  slug          String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  products      products[]
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  slug       String     @unique
  categoryId Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  products   products[]
  category   Categories @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId], map: "subcategories_categoryId_fkey")
  @@map("subcategories")
}

model MaterialCare {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  careType    String?
  material    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  icon        String?


  products    products[]   

  @@map("material_care")
}

model DeliveryOptions {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  minTime     Int
  maxTime     Int
  cutOffTime  String
  cost        Float
  freeOver    Float?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("delivery_options")
}

model BlogCategories {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blogs[]

  @@map("blog_categories")
}

model Blogs {
  id         Int            @id @default(autoincrement())
  title      String
  slug       String         @unique(map: "Blogs_slug_key")
  content    String         @db.LongText
  categoryId Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  image      String?
  category   BlogCategories @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "blogs_categoryId_fkey")
  @@map("blogs")
}

model brand {
  id         Int        @id @default(autoincrement())
  name       String     @unique(map: "Brand_name_key")
  logo       String?
  isTrending Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime
  products   products[]
}

model productimage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  colorId   Int?
  primary   Boolean  @default(false)
  productId Int
  products  products @relation(fields: [productId], references: [id], map: "ProductImage_productId_fkey")

  @@index([productId], map: "ProductImage_productId_fkey")
}



model products {
  id               Int              @id @default(autoincrement())
  slug             String           @unique
  description      String?
  createdAt        DateTime         @default(now())
  active           Boolean          @default(true)
  barcode          String?
  baseQty          Int
  brandId          Int?
  careAdvice       String?
  categoryId       Int?
  costPrice        Float
  discountPrice    Float?
  fitType          String?
  sellingPrice     Float
  shortDescription String?
  subcategoryId    Int?
  title            String
  updatedAt        DateTime
  productimage     productimage[]
  brand            brand?           @relation(fields: [brandId], references: [id], map: "Products_brandId_fkey")
  categories       Categories?      @relation(fields: [categoryId], references: [id], map: "Products_categoryId_fkey")
  subcategories    Subcategory?     @relation(fields: [subcategoryId], references: [id], map: "Products_subcategoryId_fkey")
  productvariant   productvariant[]

  materialCareId   Int?
  materialCare     MaterialCare? @relation(fields: [materialCareId], references: [id])

  @@index([brandId], map: "Products_brandId_fkey")
  @@index([categoryId], map: "Products_categoryId_fkey")
  @@index([subcategoryId], map: "Products_subcategoryId_fkey")
}


model productvariant {
  id        Int      @id @default(autoincrement())
  sku       String
  price     Float
  stock     Int
  isActive  Boolean  @default(true)
  colorId   Int?
  sizeId    Int?
  productId Int
  products  products @relation(fields: [productId], references: [id], map: "ProductVariant_productId_fkey")
  color     Colors?  @relation(fields: [colorId], references: [id])

  @@index([productId], map: "ProductVariant_productId_fkey")
  @@index([colorId], map: "productvariant_colorId_fkey")
}


model Address {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String?
  company     String?
  address1    String
  address2    String?
  city        String
  country     String
  postalCode  String
  phone       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 🔑 Relation to Users
  userId Int
  user   Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}
