  affiliateId  Int
  affiliate    Affiliate @relation(fields: [affiliateId], references: [id])

  invoiceNumber String
  invoiceUrl    String
  monthLabel    String
  totalAmount   Float

  // Payment
  isPaid        Boolean  @default(false)
  paymentMethod String?
  paymentRef    String?
  paidAt        DateTime?
  deductionAmount Float? @default(0)


  createdAt DateTime @default(now())

  @@map("affiliate_invoice")
}


model HomePageSetting {
  id              Int      @id @default(autoincrement())
  heroSlides      Json?
  shopByCategory  Json?
  midBanner       String?
  signatureProducts Json?
  headerText         String?   @db.LongText
  affiliateCommission Int?  
  ambassadorCommission Int?

  // NEW — Homepage section data
  trendingProducts   Json?    // Array of product IDs (admin-picked)
  bestSellerProducts Json?    // Array of product IDs (admin-picked or auto)
  shopByColors       Json?    // Array of color IDs to feature

