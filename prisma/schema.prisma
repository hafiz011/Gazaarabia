generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users Users[]

  @@map("roles")
}

model Users {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  phone          String?
  password       String
  roleId         Int
  isGuest        Boolean  @default(false)
  createdAt      DateTime @default(now())
  role           Roles    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdCoupons Coupon[] @relation("CouponCreator")

  affiliate Affiliate?

  addresses     Address[]
  wishlist      Wishlist[]
  carts         Cart[]
  orders        Orders[]
  reviews       Review[]
  notifications notifications[]
  returnRequests ReturnRequest[]


  @@index([roleId], map: "users_roleId_fkey")
  @@map("users")
}

model Sizes {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?   @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productvariant productvariant[]
  carts          Cart[]

  @@map("sizes")
}

model Colors {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  hexCode        String
  rgbCode        String?
  description    String?          @db.LongText
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  productvariant productvariant[]
  carts          Cart[]

  @@map("colors")
}

model Categories {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  slug          String        @unique
  image         String?  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  products      products[]
  subcategories Subcategory[]

  menus    Menus[]    @relation("CategoryMenus")
  Submenus Submenus[]

  @@map("categories")
}

model Subcategory {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  slug       String     @unique
  categoryId Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  products   products[]
  category   Categories @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  submenus Submenus[] @relation("SubcategorySubmenus")

  @@index([categoryId], map: "subcategories_categoryId_fkey")
  @@map("subcategories")
}

model MaterialCare {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.LongText
  careType    String?
  material    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  icon        String?

  products products[]

  @@map("material_care")
}

model DeliveryOptions {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.LongText
  minTime     Int
  maxTime     Int
  cutOffTime  String
  cost        Float
  freeOver    Float?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("delivery_options")
}

model BlogCategories {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blogs[]

  menus Menus[] @relation("BlogCategoryMenus")

  @@map("blog_categories")
}

model Blogs {
  id         Int            @id @default(autoincrement())
  title      String
  slug       String         @unique(map: "Blogs_slug_key")
  content    String         @db.LongText
  categoryId Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  image      String?
  category   BlogCategories @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "blogs_categoryId_fkey")
  @@map("blogs")
}

model brand {
  id         Int        @id @default(autoincrement())
  name       String     @unique(map: "Brand_name_key")
  logo       String?
  isTrending Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  products   products[]
}

model productimage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  colorId   Int?
  primary   Boolean  @default(false)
  productId Int
  products  products @relation(fields: [productId], references: [id], map: "ProductImage_productId_fkey")

  @@index([productId], map: "ProductImage_productId_fkey")
}

model products {
  id               Int              @id @default(autoincrement())
  slug             String           @unique
  description      String?          @db.LongText
  active           Boolean          @default(true)
  barcode          String?
  baseQty          Int
  brandId          Int?
  categoryId       Int?
  costPrice        Float
  discountPrice    Float?
  fitType          String?
  sellingPrice     Float
  shortDescription String?           @db.LongText
  subcategoryId    Int?
  title            String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  productimage     productimage[]
  brand            brand?           @relation(fields: [brandId], references: [id], map: "Products_brandId_fkey")
  categories       Categories?      @relation(fields: [categoryId], references: [id], map: "Products_categoryId_fkey")
  subcategories    Subcategory?     @relation(fields: [subcategoryId], references: [id], map: "Products_subcategoryId_fkey")
  productvariant   productvariant[]

  materialCareId Int?
  materialCare   MaterialCare? @relation(fields: [materialCareId], references: [id])

  wishlist      Wishlist[]
  carts         Cart[]
  orderItems    OrderItem[]
  reviews       Review[]
  variantImages VariantImage[]

  soldHighlightDuration Int?     // duration in hours
  soldCount             Int?     // number sold in this duration

  ambassadorId          Int?     // assigned ambassador
  ambassador   Affiliate? @relation("AffiliateAmbassadorRelation", fields: [ambassadorId], references: [id])



  // NEW — Back-relations for ProductRelation
  asParentRelations ProductRelation[] @relation("ProductAsParent")
  asChildRelations  ProductRelation[] @relation("ProductAsChild")

  @@index([brandId], map: "Products_brandId_fkey")
  @@index([categoryId], map: "Products_categoryId_fkey")
  @@index([subcategoryId], map: "Products_subcategoryId_fkey")
}

model productvariant {
  id        Int     @id @default(autoincrement())
  sku       String
  price     Float
  stock     Int
  isActive  Boolean @default(true)
  colorId   Int?
  sizeId    Int?
  productId Int

  products products @relation(fields: [productId], references: [id], map: "ProductVariant_productId_fkey")
  color    Colors?  @relation(fields: [colorId], references: [id])
  size     Sizes?   @relation(fields: [sizeId], references: [id])

  variantImages VariantImage[]
  carts         Cart[]
  orderItems    OrderItem[] // This is required to complete the relation
  reviews       Review[]

  @@index([productId], map: "ProductVariant_productId_fkey")
  @@index([colorId], map: "productvariant_colorId_fkey")
}

model VariantImage {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String?
  variantId Int
  productId Int?

  variant productvariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product products?      @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("variant_images")
}

model Address {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String?
  company    String?
  address1   String
  address2   String?
  city       String
  country    String
  postalCode String
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  //  Relation to Users
  userId Int
  user   Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  // Relations
  user    Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // Prevent duplicate wishlist entries
  @@map("wishlist")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  colorId   Int?
  sizeId    Int?
  variantId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product products       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Colors?        @relation(fields: [colorId], references: [id])
  size    Sizes?         @relation(fields: [sizeId], references: [id])
  variant productvariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId]) // Prevent duplicate variant entries in the cart
  @@map("carts")
}

model Orders {
  id     Int @id @default(autoincrement())
  userId Int

  //  Amount Details
  itemsTotal    Float
  subtotal      Float
  shippingCost  Float  @default(0)
  discountTotal Float  @default(0)
  taxTotal      Float  @default(0)
  totalAmount   Float
  currency      String @default("GBP")

  //  Payment Info
  paymentMethod  String
  transactionId  String?
  status         String  @default("pending")
  paypalResponse Json?

  //  Shipping Address Snapshot
  addressId  Int?
  firstName  String
  lastName   String?
  company    String?
  address1   String
  address2   String?
  city       String
  country    String
  postalCode String
  phone      String

  //  Delivery Options
  deliveryOptionId Int?
  deliveryName     String?
  deliveryEta      String?

  //  Meta
  notes          String?
  couponCode     String?
  couponDiscount Float?  @default(0)

  // Coupon relation (NEW)
  couponId Int?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  // Direct affiliate relation (NEW)
  affiliateId         Int?
  affiliateCommission Float? // <-- store % used at order time
  affiliateEarning    Float? // <-- store calculated earning (money)
  // Affiliate relation (coupon-based)
  affiliate           Affiliate? @relation("OrderAffiliateRelation", fields: [affiliateId], references: [id])

  affiliatePaid Boolean @default(false)

  invoiceNumber String?   // stores invoice code like INV-000001
  invoiceUrl    String?   // link to PDF stored locally or S3

  charityDonationId Int?
  charityAmount Float? @default(0)
  charityDonation CharityDonations?

  ambassadorId   Int?
  ambassadorPaid Boolean @default(false)

  // Ambassador relation (product-based)
  ambassador          Affiliate? @relation("OrderAmbassadorRelation", fields: [ambassadorId], references: [id])


  //  Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //  Relations
  user       Users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  returnRequests ReturnRequest[]


  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        Int  @id @default(autoincrement())
  orderId   Int
  productId Int
  variantId Int // main source of truth (points to productvariant)
  colorId   Int?
  sizeId    Int?

  quantity Int
  price    Float
  subtotal Float
  sku      String?
  title    String?
  reviewed Boolean @default(false)

  //  Ambassador earning tracking per product
  ambassadorId         Int?
  ambassadorCommission Float?
  ambassadorEarning    Float?
  ambassadorPaid       Boolean @default(false)   //  NEW: paid/unpaid status

  returnStatus         String?
  refundedAmount       Float?
 

  // Affiliate commission per item
  affiliateEarning       Float?
  affiliateCommissionAdjusted Boolean @default(false)

  // Ambassador commission per item
  ambassadorCommissionAdjusted Boolean @default(false)


  ambassador Affiliate? @relation("OrderItemAmbassadorRelation", fields: [ambassadorId], references: [id])


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Orders         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product products       @relation(fields: [productId], references: [id])
  variant productvariant @relation(fields: [variantId], references: [id]) //  matches productvariant.orderItems

  reviews Review[]
  returnRequests ReturnRequest[]


  @@map("orders_item")
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Product Reference
  productId Int
  product   products @relation(fields: [productId], references: [id])

  // Variant Reference 
  variantId Int?
  variant   productvariant? @relation(fields: [variantId], references: [id])

  // User Reference
  userId Int
  user   Users @relation(fields: [userId], references: [id])

  // Optional: Link back to order item
  orderItemId Int?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  @@map("review")
}

model Menus {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  type      String
  images    Json?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submenus     Submenus[]
  category     Categories?     @relation("CategoryMenus", fields: [categoryId], references: [id])
  blogCategory BlogCategories? @relation("BlogCategoryMenus", fields: [blogCategoryId], references: [id])

  categoryId     Int?
  blogCategoryId Int?

  @@map("menus")
}

model Submenus {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  menuId             Int
  categoryId         Int?
  subcategoryId      Int?
  leftSubcategories  Json? // store selected left subcategory IDs (only if product)
  rightSubcategories Json? // store selected right subcategory IDs (only if product)
  leftCustomLinks    Json?
  rightCustomLinks   Json?
  position           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  menu        Menus        @relation(fields: [menuId], references: [id], onDelete: Cascade, map: "submenus_menuId_fkey")
  category    Categories?  @relation(fields: [categoryId], references: [id], onDelete: Cascade, map: "submenus_categoryId_fkey")
  subcategory Subcategory? @relation("SubcategorySubmenus", fields: [subcategoryId], references: [id], onDelete: Cascade, map: "submenus_subcategoryId_fkey")

  @@map("submenus")
}

model ProductRelation {
  id           Int      @id @default(autoincrement())
  parentId     Int
  childId      Int
  relationType String   @default("wear_with")
  sortOrder    Int?
  createdAt    DateTime @default(now())

  // Properly linked relations with unique names
  parent products @relation("ProductAsParent", fields: [parentId], references: [id], onDelete: Cascade)
  child  products @relation("ProductAsChild", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId, relationType])
  @@map("product_relations")
}

model notifications {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String?
  subject   String
  message   String
  type      String // e.g. "email", "sms", etc.
  status    String // "sent", "failed"
  createdAt DateTime @default(now())

  user Users? @relation(fields: [userId], references: [id])
}

model FaqCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faqs Faq[] // One-to-many relation

  @@map("faq_categories")
}

model Faq {
  id         Int      @id @default(autoincrement())
  question   String
  answer     String
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("faqs")
}

model ContactUs {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_us")
}

model Affiliate {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique(map: "Affiliate_userId_unique")
  user            Users    @relation(fields: [userId], references: [id])
  baseCommission  Float    @default(10) // Admin's commission percentage
  shareCommission Float    @default(7) // Affiliate's shared portion (% discount)

  type        String   @default("affiliate") // "affiliate" or "ambassador"


  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Back-relations
  payouts Payout[]
  coupons Coupon[] // coupons owned by this affiliate

  invoices AffiliateInvoice[]
  ambassadorInvoices AmbassadorInvoice[]


  // Order-level commissions
  orders            Orders[] @relation("OrderAffiliateRelation")
  ambassadorOrders  Orders[] @relation("OrderAmbassadorRelation")

  // Item-level ambassador commissions
  orderItemAmbassadors OrderItem[] @relation("OrderItemAmbassadorRelation")

  // Product-level ambassador mapping
  products products[] @relation("AffiliateAmbassadorRelation")



 @@map("affiliate")
}

model Payout {
  id            Int       @id @default(autoincrement())
  affiliateId   Int
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id])
  amount        Float
  status        String    @default("pending") // pending | paid
  paymentMethod String?
  paymentRef    String?
  invoiceUrl    String? 
  periodLabel   String? 
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
}

model Coupon {
  id            Int    @id @default(autoincrement())
  code          String @unique
  discountType  String @default("percentage") // "percentage" | "fixed"
  discountValue Float

  // Relations
  affiliateId Int?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  creatorId Int? // who created this coupon (admin or affiliate)
  creator   Users? @relation("CouponCreator", fields: [creatorId], references: [id])

  // Usage and limits
  usageCount     Int       @default(0)
  maxUsage       Int?
  perUserLimit   Int?      @default(1)
  minOrderAmount Float?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)

  //  Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //  Optional relation to Orders (if you track coupon usage per order)
  orders Orders[]

  @@map("coupon")
}


model AffiliateInvoice {
  id           Int      @id @default(autoincrement())
  affiliateId  Int
  affiliate    Affiliate @relation(fields: [affiliateId], references: [id])

  invoiceNumber String
  invoiceUrl    String
  monthLabel    String
  totalAmount   Float

  // Payment
  isPaid        Boolean  @default(false)
  paymentMethod String?
  paymentRef    String?
  paidAt        DateTime?
  deductionAmount Float? @default(0)


  createdAt DateTime @default(now())

  @@map("affiliate_invoice")
}


model HomePageSetting {
  id              Int      @id @default(autoincrement())
  heroSlides      Json?
  shopByCategory  Json?
  midBanner       String?
  signatureProducts Json?
  headerText         String? 
  affiliateCommission Int?  
  ambassadorCommission Int?

  
  updatedAt       DateTime @updatedAt

  @@map("homepage_settings")
}


model ReturnReason {
  id           Int      @id @default(autoincrement())
  label        String   @unique
  requireImage Boolean  @default(false)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  returnRequests ReturnRequest[]

   @@map("return_reasons")
}


model ReturnRequest {
  id           Int      @id @default(autoincrement())

  // Relations
  userId       Int
  orderId      Int
  orderItemId  Int
  reasonId     Int

  user         Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Orders       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  reason       ReturnReason @relation(fields: [reasonId], references: [id], onDelete: Cascade)

  // Customer Inputs
  note         String?      // optional explanation
  images       Json?        // store image URLs

  // Process & Status Tracking
  status       String       @default("pending") 
  // possible values:
  // pending → waiting admin review
  // approved → admin approved, waiting customer to return
  // rejected → admin rejected
  // returned → customer completed the return
  // refunded → refund processed

  adminNote    String?
  refundAmount Float?

  expectedReturnAmount Float? @default(0) 

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("return_requests")
}


model SolidarityReceipts {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  amount       Float
  receiptImage String?   // store uploaded image URL
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("solidarity_receipts")
}


model CharityDonations {
  id            Int       @id @default(autoincrement())
  name          String?   // Optional donor name
  email         String     // Required email
  amount        Float      // Donation amount
  anonymous     Boolean    @default(false)
  message       String?    @db.LongText

  transactionId String?    // PayPal/Stripe transaction ID
  paymentMethod String?    // "paypal" | "stripe" | ""
  paymentStatus String     @default("pending") 
  // pending | success | failed

  receiptUrl    String?    // Optional donation receipt PDF/image

  orderId       Int?       @unique 
  order         Orders? @relation(fields: [orderId], references: [id])

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("charity_donations")
}


model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("subscribers")
}


model AmbassadorInvoice {
  id            Int      @id @default(autoincrement())
  ambassadorId  Int
  ambassador    Affiliate @relation(fields: [ambassadorId], references: [id])

  invoiceNumber String
  invoiceUrl    String
  monthLabel    String
  totalAmount   Float

  isPaid        Boolean  @default(false)
  paymentMethod String?
  paymentRef    String?
  paidAt        DateTime?
  deductionAmount Float? @default(0)


  createdAt DateTime @default(now())

  @@map("ambassador_invoice")
}



model DeliverySettings {
  id                       Int      @id @default(1)

  freeDeliveryText         String?

  nextDayTitle             String?
  nextDayDeliveryTime      String?
  nextDayCost              String?
  nextDayOrderCutOff       String?

  standardDeliveryTitle    String?
  standardDeliveryMinDays  Int?
  standardDeliveryMaxDays  Int?
  standardDeliveryCost     String?

  returnText               String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("delivery_settings")
}
