# ==============================================================================
# GAZAARABIA SHOPIFY APP — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development or VPS deployment.
# ==============================================================================

# Shopify App Credentials (from Shopify Partner / Dev Dashboard)
SHOPIFY_API_KEY="<SHOPIFY_API_KEY>"
SHOPIFY_API_SECRET="<SHOPIFY_API_SECRET>"
SCOPES="read_inventory,read_products,write_orders,read_orders,read_customers"

# Shopify App URL
# Development: Leave unset when using `shopify app dev` (CLI injects tunnel URL)
# Production: https://shopify.gazaarabia.com
SHOPIFY_APP_URL="https://shopify.gazaarabia.com"

# Session & Mapping Database (MySQL)
DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>"

# Server Port (Node server listens on this port)
PORT="3001"

# Reliability Queue (Redis for BullMQ)
# Optional in local dev (falls back to synchronous execution)
# Strongly recommended in production
REDIS_URL="redis://<REDIS_HOST>:6379"

# Gazaarabia Marketplace Backend Integration
GAZAARABIA_API_URL="https://gazaarabia.com"
GAZAARABIA_APP_URL="https://gazaarabia.com"

# Shared Internal Secret for Gazaarabia <-> Shopify App server-to-server auth
# MUST match GAZAARABIA_INTERNAL_SECRET in the Gazaarabia root app environment
GAZAARABIA_INTERNAL_SECRET="<GENERATE_RANDOM_INTERNAL_SECRET_32_PLUS_CHARS>"
